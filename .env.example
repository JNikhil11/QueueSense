# ==========================================================
# QueueSense Environment Configuration
# Techfest, IIT Bombay × AWS ShipIt Challenge 2026
# ==========================================================

# AWS Deployment & Region Settings
AWS_REGION=ap-southeast-2
ENVIRONMENT=prod
TABLE_NAME=QueueSense-Main

# Security & Rate Limiting Credentials
ADMIN_API_KEY=queuesense-admin-secret-change-in-production
RATE_LIMIT_SALT=queuesense_privacy_salt_2026

# Storage Backend Override (Optional)
# In production Lambda: Defaults to 'dynamodb'
# In local development: Set to 'memory' to simulate without AWS credentials
STORAGE_BACKEND=dynamodb

# Frontend Configuration
VITE_API_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com
VITE_DATA_MODE=demo        # 'production' (strictly fails closed if API fails) | 'demo' (local simulation)
VITE_CAMPUS_ID=iitb         # 'iitb' (10 IIT Bombay outlets) | 'vitap' (5 VIT-AP outlets)
VITE_ADMIN_KEY=            # Optional local admin bearer key for unlocking /admin stream in UI
