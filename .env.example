# ==========================================================
# QueueSense Environment Configuration
# Techfest, IIT Bombay × AWS ShipIt Challenge 2026
# ==========================================================

# AWS Deployment & Region Settings
AWS_REGION=ap-southeast-2
ENVIRONMENT=production
DATA_MODE=production
TABLE_NAME=QueueSense-Main

# Security & Rate Limiting Credentials
# Production Runtime Salt Delivery via AWS SSM Parameter Store:
# 1. Generate a 256-bit high-entropy secret locally:
#    openssl rand -hex 32
# 2. Provision the secret as a SecureString parameter in SSM (one-time setup):
#    aws ssm put-parameter --name "/queuesense/prod/rate_limit_salt" --type SecureString --value "<generated-secret>" --overwrite --region ap-southeast-2
# SubmitReportFunction retrieves this securely at runtime via RATE_LIMIT_SALT_PARAMETER_NAME (/queuesense/${Environment}/rate_limit_salt) with in-memory caching.
# For local development or non-AWS testing only, RATE_LIMIT_SALT can be provided directly as an environment variable below.
# Production strictly fails closed if RATE_LIMIT_SALT is absent, < 32 characters, or matches predictable phrases.
# Do NOT commit production secrets to version control or expose in frontend bundles.
RATE_LIMIT_SALT=

# Administrative Authorization
# In production, administrative endpoints (/admin/reports) are authenticated via AWS Cognito User Pool
# with JWT authorizer and an 'Admins' group policy (QueueSenseUserPool / QueueSenseAdminGroup).
# No shared static admin keys are permitted in production or exposed to the frontend bundle.

# Storage Backend Override (Internal testing only)
# In production Lambda: Defaults to DynamoDB single-table
# In isolated unit tests: Set to 'memory'
STORAGE_BACKEND=dynamodb

# Frontend Configuration (Vite)
# Base URL of deployed API Gateway HTTP API (e.g. https://xxxxxx.execute-api.ap-southeast-2.amazonaws.com)
VITE_API_URL=
VITE_DATA_MODE=demo        # 'production' (strictly fails closed if API fails) | 'demo' (local simulation)
VITE_CAMPUS_ID=iitb         # 'iitb' (10 IIT Bombay outlets) | 'vitap' (5 VIT-AP outlets)
# Never expose ADMIN_API_KEY or RATE_LIMIT_SALT through a VITE_ variable or frontend bundle.
